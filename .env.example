# Copy this file to `.env` and adjust values for local development.
# Never commit real secrets.

# Django
SECRET_KEY=change-me-to-a-long-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8091,http://127.0.0.1:8091

# PostgreSQL (used by Django and docker-compose db service)
POSTGRES_DB=attendance
POSTGRES_USER=attendance
POSTGRES_PASSWORD=attendance
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Django database URL (must match PostgreSQL settings above)
DATABASE_URL=postgres://attendance:attendance@db:5432/attendance

# React (browser-facing API URL when using Docker)
VITE_API_BASE_URL=http://localhost:8000

# Browser-facing public Status site. Never a Docker-internal hostname.
# Local independent Status service: http://localhost:8090
# Production: https://status.checkstation.app
VITE_STATUS_PUBLIC_URL=http://localhost:8090

# Browser-facing public Docs site. Never a Docker-internal hostname.
# Local independent Docs website: http://localhost:8091
# Production: https://docs.checkstation.app
VITE_DOCS_PUBLIC_URL=http://localhost:8091

# Browser-facing promotional CheckStation site origin. Used for Contact
# canonical URLs. Production: https://checkstation.app
# Leave empty to use the current window origin. Never put a private
# management hostname in this (or any other) VITE_* value.
VITE_PUBLIC_SITE_URL=http://localhost:5173

# Browser origin used in auth emails (verification + password reset) and
# Stripe return URLs. Local: http://localhost:5173
# Production intent (DEC-088, not wired in application code yet):
# https://workspace.checkstation.app
# Use the URL people open in a browser, not an internal Docker hostname.
FRONTEND_BASE_URL=http://localhost:5173

# Browser-facing Docs origin used in public document canonical URLs.
# Local: http://localhost:8091
# Production: https://docs.checkstation.app
DOCS_PUBLIC_URL=http://localhost:8091

# Optional legal-entity placeholders substituted into Privacy/Terms at serve time.
# Leave empty to use conservative fallbacks. Do not invent a company name.
# Production intent (DEC-088): contact@checkstation.app
LEGAL_OPERATOR_NAME=
LEGAL_CONTACT_EMAIL=contact@checkstation.app
LEGAL_GOVERNING_LAW=
LEGAL_GOVERNING_VENUE=

# Public Contact mailbox (Cloudflare Email Routing). Never the private
# forwarding destination. Separate from LEGAL_CONTACT_EMAIL even when they
# use the same public address. Production intent: contact@checkstation.app
CONTACT_TO_EMAIL=contact@checkstation.app

# Cloudflare Turnstile (Contact). Backend-only configuration.
# The public site key is served to the browser by GET /api/contact/categories/
# (turnstile_site_key). Do not put TURNSTILE_SECRET_KEY in VITE_* or the
# frontend container.
#
# Local DEBUG: leave BOTH empty → official Cloudflare always-pass test keys
#   (localhost cannot use the production widget hostname checkstation.app).
# Production (DEBUG=False / checkstation.app): set BOTH. Empty → fail closed 503.
# Never commit real keys.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Transactional auth email via Resend. Leave the API key empty in this example.
# Put the real key only in local `.env` (never commit it).
# Production intent (DEC-088): accounts@checkstation.app
RESEND_API_KEY=
RESEND_FROM_EMAIL=accounts@checkstation.app
RESEND_FROM_NAME=Check Station

# Optional Fernet key for encrypting platform-admin TOTP secrets at rest.
# Leave empty locally; Django derives a key from SECRET_KEY in DEBUG.
# Generate a dedicated key before production:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PLATFORM_2FA_ENCRYPTION_KEY=

# Optional Fernet key for Group SMTP passwords and other reversible app secrets.
# Leave empty locally; Django derives a key from SECRET_KEY in DEBUG.
APP_SECRETS_ENCRYPTION_KEY=

# Stripe TEST mode. Leave empty until a Stripe account exists.
# Never put live keys here. Map Price IDs to billing.catalog plan/interval.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLUS_MONTHLY=
STRIPE_PRICE_PLUS_YEARLY=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_YEARLY=

# Stripe Promotions — sandbox coupon IDs only (server-side).
# Paste existing Stripe coupon IDs here. Never commit real IDs.
# Never put these in VITE_* or expose them via public APIs.
# Group 1 New/Basic NORMAL
STRIPE_COUPON_ACQ_NORMAL_PLUS_MONTHLY=
STRIPE_COUPON_ACQ_NORMAL_BUSINESS_MONTHLY=
STRIPE_COUPON_ACQ_NORMAL_PLUS_YEARLY=
STRIPE_COUPON_ACQ_NORMAL_BUSINESS_YEARLY=
# Group 1 New/Basic BIG
STRIPE_COUPON_ACQ_BIG_PLUS_MONTHLY=
STRIPE_COUPON_ACQ_BIG_BUSINESS_MONTHLY=
STRIPE_COUPON_ACQ_BIG_PLUS_YEARLY=
STRIPE_COUPON_ACQ_BIG_BUSINESS_YEARLY=
# Group 2 Plus Monthly retention (simple annual offers)
STRIPE_COUPON_PLUS_MONTHLY_TO_PLUS_YEARLY=
# Shared Business Yearly $45 off (Plus Monthly → Business Yearly and
# Business Monthly → Business Yearly). Same coupon ID; eligibility is server-side.
STRIPE_COUPON_BUSINESS_MONTHLY_TO_YEARLY=

# Business trial length in days. Leave 0 until the duration is frozen.
# The API will not offer trial checkout while this is 0.
BUSINESS_TRIAL_DAYS=0

# stripe (default) or fake (automated tests).
BILLING_PROVIDER=stripe

# Independent Status service (host-run). Docker Compose uses in-network
# hostnames for probes and does not require these for the status container.
# STATUS_API_URL=http://localhost:8000
# STATUS_WEBSITE_URL=http://localhost:5173
# STATUS_WORKSPACE_URL=http://localhost:5173
# STATUS_DOCS_URL=http://localhost:8091
# STATUS_PROBE_INTERVAL_SECONDS=60
# STATUS_STALE_THRESHOLD_SECONDS=180
# STATUS_HTTP_TIMEOUT_SECONDS=8
# STATUS_BROWSER_POLL_SECONDS=30
# STATUS_PORT=8090
# STATUS_DATA_DIR=./status/data

# Independent Docs website (host-run). Browser-facing API must not be a
# Docker-internal hostname. Compose sets DOCS_INTERNAL_API_URL=http://backend:8000
# for server-side meta fetch only.
# DOCS_API_BASE_URL=http://localhost:8000
# DOCS_INTERNAL_API_URL=http://localhost:8000
# DOCS_PORT=8091
# DOCS_MAIN_SITE_URL=http://localhost:5173
# STATUS_PUBLIC_URL=http://localhost:8090
