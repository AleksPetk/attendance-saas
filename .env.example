# =============================================================================
# LOCAL DEVELOPMENT
# Copy to `.env` for local work. Never commit real secrets.
# This file is NOT a production-ready secret set.
# =============================================================================

# --- Django (local) ---
# Generate a long random value for local use; do not reuse in production.
SECRET_KEY=replace-with-a-long-random-local-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Credentialed browser origins = local workspace SPA only (cookies).
# Do NOT put Docs/Status/promo production hosts here.
CORS_CREDENTIALED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Anonymous CORS (no credentials) for Docs/Status. Local combined SPA keeps
# promo Contact on :5173 (same origin as workspace — credentialed).
CORS_ANONYMOUS_ORIGINS=http://localhost:8091,http://127.0.0.1:8091,http://localhost:8090,http://127.0.0.1:8090
# CSRF trust defaults to credentialed origins. Contact is csrf_exempt.
# CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL (used by Django and docker-compose db service — local only)
POSTGRES_DB=attendance
POSTGRES_USER=attendance
POSTGRES_PASSWORD=replace-local-db-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgres://attendance:replace-local-db-password@db:5432/attendance

# React (local Vite). Production builds must not ship localhost — see PRODUCTION.
VITE_API_BASE_URL=http://localhost:8000
VITE_STATUS_PUBLIC_URL=http://localhost:8090
VITE_DOCS_PUBLIC_URL=http://localhost:8091
VITE_PUBLIC_SITE_URL=http://localhost:5173

# Browser origin used in auth emails and Stripe return URLs.
FRONTEND_BASE_URL=http://localhost:5173
DOCS_PUBLIC_URL=http://localhost:8091

# Optional legal-entity placeholders. Leave empty to use conservative fallbacks.
LEGAL_OPERATOR_NAME=
LEGAL_CONTACT_EMAIL=contact@checkstation.app
LEGAL_GOVERNING_LAW=
LEGAL_GOVERNING_VENUE=

CONTACT_TO_EMAIL=contact@checkstation.app

# Cloudflare Turnstile (Contact). Local DEBUG: leave both empty → always-pass test keys.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Transactional email (Resend). Leave empty locally.
RESEND_API_KEY=
RESEND_FROM_EMAIL=accounts@checkstation.app
RESEND_FROM_NAME=CheckStation
EMAIL_BRAND_LOGO_URL=

# Fernet keys — optional in local DEBUG (derived from SECRET_KEY with a warning).
# REQUIRED in production (hard failure). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PLATFORM_2FA_ENCRYPTION_KEY=
APP_SECRETS_ENCRYPTION_KEY=

# Status → Django provider health shared secret (email/stripe).
# Empty in local DEBUG allows those endpoints without a token.
# REQUIRED when DJANGO_SETTINGS_MODULE=config.settings_production.
STATUS_PROBE_TOKEN=

# Stripe TEST mode placeholders. Never put live keys here.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLUS_MONTHLY=
STRIPE_PRICE_PLUS_YEARLY=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_YEARLY=
STRIPE_PRICE_JP_PLUS_MONTHLY=
STRIPE_PRICE_JP_PLUS_YEARLY=
STRIPE_PRICE_JP_BUSINESS_MONTHLY=
STRIPE_PRICE_JP_BUSINESS_YEARLY=
STRIPE_COUPON_JP_ACQ_NORMAL_PLUS_MONTHLY=
STRIPE_COUPON_JP_ACQ_NORMAL_BUSINESS_MONTHLY=
STRIPE_COUPON_JP_ACQ_NORMAL_PLUS_YEARLY=
STRIPE_COUPON_JP_ACQ_NORMAL_BUSINESS_YEARLY=
STRIPE_COUPON_JP_ACQ_BIG_PLUS_MONTHLY=
STRIPE_COUPON_JP_ACQ_BIG_BUSINESS_MONTHLY=
STRIPE_COUPON_JP_ACQ_BIG_PLUS_YEARLY=
STRIPE_COUPON_JP_ACQ_BIG_BUSINESS_YEARLY=
STRIPE_COUPON_JP_PLUS_MONTHLY_TO_PLUS_YEARLY=
STRIPE_COUPON_JP_BUSINESS_MONTHLY_TO_YEARLY=
STRIPE_COUPON_JP_BUSINESS_UPGRADE_YEARLY=
STRIPE_COUPON_ACQ_NORMAL_PLUS_MONTHLY=
STRIPE_COUPON_ACQ_NORMAL_BUSINESS_MONTHLY=
STRIPE_COUPON_ACQ_NORMAL_PLUS_YEARLY=
STRIPE_COUPON_ACQ_NORMAL_BUSINESS_YEARLY=
STRIPE_COUPON_ACQ_BIG_PLUS_MONTHLY=
STRIPE_COUPON_ACQ_BIG_BUSINESS_MONTHLY=
STRIPE_COUPON_ACQ_BIG_PLUS_YEARLY=
STRIPE_COUPON_ACQ_BIG_BUSINESS_YEARLY=
STRIPE_COUPON_PLUS_MONTHLY_TO_PLUS_YEARLY=
STRIPE_COUPON_BUSINESS_MONTHLY_TO_YEARLY=
BILLING_PROVIDER=stripe

# Optional owner Google OAuth. Leave empty locally for password-only auth.
# Production callback (no api.* host):
# GOOGLE_OAUTH_REDIRECT_URI=https://workspace.checkstation.app/api/auth/google/callback/
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# Optional owner Apple OAuth.
# APPLE_OAUTH_REDIRECT_URI=https://workspace.checkstation.app/api/auth/apple/callback/
APPLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_TEAM_ID=
APPLE_OAUTH_KEY_ID=
APPLE_OAUTH_PRIVATE_KEY=
APPLE_OAUTH_REDIRECT_URI=

# Independent Status / Docs (host-run). Compose uses in-network probe URLs.
# STATUS_API_URL=http://localhost:8000
# STATUS_WEBSITE_URL=http://localhost:5173
# STATUS_WORKSPACE_URL=http://localhost:5173
# STATUS_DOCS_URL=http://localhost:8091
# DOCS_API_BASE_URL=http://localhost:8000
# DOCS_INTERNAL_API_URL=http://localhost:8000
# DOCS_MAIN_SITE_URL=http://localhost:5173
#
# Production Compose defaults / recommended in-network values:
# STATUS_API_URL=http://backend:8000
# STATUS_DOCS_URL=http://docs:8091
# DOCS_INTERNAL_API_URL=http://backend:8000
# DOCS_API_BASE_URL=https://workspace.checkstation.app
# (Status probes send X-Forwarded-Proto: https for Django SECURE_SSL_REDIRECT.)

# =============================================================================
# PRODUCTION REQUIRED
# Use DJANGO_SETTINGS_MODULE=config.settings_production
# Generate every secret; never paste real values into this example file.
# Frozen hosts:
#   https://checkstation.app              promotional website
#   https://workspace.checkstation.app    workspace + auth + kiosk + /api/...
#   https://docs.checkstation.app         Docs
#   https://status.checkstation.app       Status
#   https://manager.checkstation.app      platform admin (reverse-proxy later)
# There is NO api.checkstation.app — public API is workspace.../api/...
# =============================================================================
#
# DEBUG=False
# SECRET_KEY=<generate long random>
# ALLOWED_HOSTS=workspace.checkstation.app,manager.checkstation.app
# APP_SECRETS_ENCRYPTION_KEY=<fernet>
# PLATFORM_2FA_ENCRYPTION_KEY=<fernet>
# STATUS_PROBE_TOKEN=<long random shared with Status service>
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
# REDIS_URL=redis://redis:6379/0
# Shared Django cache (auth rate limits, Contact, kiosk PIN/exit limits).
#
# Behind reverse proxy (nginx/Caddy on localhost):
# USE_X_FORWARDED_FOR=True
# TRUSTED_PROXY_IPS=127.0.0.1
#
# Optional auth abuse thresholds (defaults shown):
# OWNER_LOGIN_IP_LIMIT=10
# OWNER_LOGIN_ACCOUNT_LIMIT=5
# STAFF_LOGIN_IP_LIMIT=10
# PASSWORD_RESET_IP_LIMIT=5
# VERIFICATION_RESEND_IP_LIMIT=10
# CLASS_PIN_VERIFY_LIMIT=20
# KIOSK_EXIT_VERIFY_LIMIT=15
#
# Credentialed CORS = workspace only. Promo/Docs/Status are anonymous (no credentials).
# CSRF trust defaults to credentialed origins; Contact is csrf_exempt (no promo CSRF needed).
# CORS_CREDENTIALED_ORIGINS=https://workspace.checkstation.app
# CORS_ANONYMOUS_ORIGINS=https://checkstation.app,https://docs.checkstation.app,https://status.checkstation.app
# CSRF_TRUSTED_ORIGINS=https://workspace.checkstation.app
#
# FRONTEND_BASE_URL=https://workspace.checkstation.app
# DOCS_PUBLIC_URL=https://docs.checkstation.app
# STATUS_PUBLIC_URL=https://status.checkstation.app
#
# # Combined SPA on checkstation.app + workspace: use absolute workspace API.
# # Workspace-only same-origin deploy: leave VITE_API_BASE_URL empty at build time.
# VITE_API_BASE_URL=https://workspace.checkstation.app
# VITE_PUBLIC_SITE_URL=https://checkstation.app
# VITE_DOCS_PUBLIC_URL=https://docs.checkstation.app
# VITE_STATUS_PUBLIC_URL=https://status.checkstation.app
#
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=0
# SECURE_HSTS_INCLUDE_SUBDOMAINS=False
# SECURE_HSTS_PRELOAD=False
# # Raise SECURE_HSTS_SECONDS only after HTTPS is proven stable.
#
# GUNICORN_BIND=127.0.0.1:8000
# GUNICORN_WORKERS=3
