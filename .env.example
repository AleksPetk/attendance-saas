# Copy this file to `.env` and adjust values for local development.
# Never commit real secrets.

# Django
SECRET_KEY=change-me-to-a-long-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL (used by Django and docker-compose db service)
POSTGRES_DB=attendance
POSTGRES_USER=attendance
POSTGRES_PASSWORD=attendance
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Django database URL (must match PostgreSQL settings above)
DATABASE_URL=postgres://attendance:attendance@db:5432/attendance

# React (browser-facing API URL when using Docker)
VITE_API_BASE_URL=http://localhost:8000

# Public frontend origin used in auth emails (verification + password reset).
# Use the URL people open in a browser, not an internal Docker hostname.
FRONTEND_BASE_URL=http://localhost:5173

# Transactional auth email via Resend. Leave the API key empty in this example.
# Put the real key only in local `.env` (never commit it).
RESEND_API_KEY=
RESEND_FROM_EMAIL=accounts@checkstation.alekspetk.com
RESEND_FROM_NAME=Check Station

# Optional Fernet key for encrypting platform-admin TOTP secrets at rest.
# Leave empty locally; Django derives a key from SECRET_KEY in DEBUG.
# Generate a dedicated key before production:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PLATFORM_2FA_ENCRYPTION_KEY=
