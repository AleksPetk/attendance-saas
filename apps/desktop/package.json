{
  "name": "@checkstation/desktop",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5174 && electron .\"",
    "build": "vite build",
    "build:electron": "vite build && electron-builder --dir",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo 'desktop lint placeholder'",
    "test": "node --import tsx --test src/**/*.test.ts && node --test electron/**/*.test.cjs"
  },
  "dependencies": {
    "@checkstation/api": "*",
    "@checkstation/auth": "*",
    "@checkstation/config": "*",
    "@checkstation/domain": "*",
    "@checkstation/i18n": "*",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "44.2.0",
    "electron-builder": "26.16.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vite": "^6.2.0",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "app.checkstation.desktop",
    "productName": "CheckStation",
    "electronVersion": "44.2.0",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "mac": {
      "icon": "icon.png",
      "target": [
        "dir"
      ],
      "category": "public.app-category.business"
    },
    "win": {
      "target": [
        "dir"
      ]
    }
  }
}
