{
  "name": "@checkstation/desktop",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5174 && electron .\"",
    "build": "vite build && electron-builder --dir",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo 'desktop lint placeholder'",
    "test": "node --import tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@checkstation/api": "*",
    "@checkstation/auth": "*",
    "@checkstation/config": "*",
    "@checkstation/domain": "*",
    "@checkstation/i18n": "*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^34.3.0",
    "electron-builder": "^25.1.8",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vite": "^6.2.0",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "app.checkstation.desktop",
    "productName": "CheckStation",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/**/*"],
    "mac": { "target": ["dir"], "category": "public.app-category.business" },
    "win": { "target": ["dir"] }
  }
}
