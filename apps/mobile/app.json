{
  "expo": {
    "name": "CheckStation",
    "slug": "checkstation",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "checkstation",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#071426"
        }
      ],
      "expo-sharing"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.checkstation.mobile",
      "infoPlist": {
        "CFBundleDisplayName": "CheckStation"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#071426"
      },
      "package": "app.checkstation.mobile"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "https://workspace.checkstation.app/api",
      "eas": {
        "projectId": "checkstation-mobile-placeholder"
      }
    }
  }
}
