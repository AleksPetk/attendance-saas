{
  "name": "@checkstation/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "expo lint --quiet || true",
    "test": "node --import tsx --test src/**/*.test.ts",
    "eas:build:development": "eas build --profile development --platform ios",
    "eas:build:preview": "eas build --profile preview --platform ios",
    "eas:build:production": "eas build --profile production --platform ios",
    "eas:submit:production": "eas submit --profile production --platform ios --latest"
  },
  "dependencies": {
    "@checkstation/api": "*",
    "@checkstation/auth": "*",
    "@checkstation/config": "*",
    "@checkstation/domain": "*",
    "@checkstation/i18n": "*",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "@react-navigation/native": "^7.0.14",
    "expo": "~57.0.23",
    "expo-apple-authentication": "~57.0.2",
    "expo-constants": "~57.0.17",
    "expo-crypto": "~57.0.3",
    "expo-file-system": "~57.0.6",
    "expo-iap": "~3.4.0",
    "expo-image-picker": "~57.0.18",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.20",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "~19.2.4",
    "tsx": "^4.19.3",
    "typescript": "~5.9.2"
  }
}
